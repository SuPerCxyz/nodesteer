[Unit]
Description=NodeSteer Hub
Documentation=file:///usr/share/doc/nodesteer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nodesteer
Group=nodesteer
ExecStart=/usr/local/bin/nodesteer-hub --config /etc/nodesteer/hub.yaml
Restart=on-failure
RestartSec=5
StateDirectory=nodesteer-hub
StateDirectoryMode=0750
# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nodesteer-hub /etc/nodesteer

[Install]
WantedBy=multi-user.target
