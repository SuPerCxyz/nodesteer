[Unit]
Description=NodeSteer Agent
Documentation=file:///usr/share/doc/nodesteer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 小节点内存默认值；/etc/nodesteer/agent.env 可覆盖同名变量。
# 不设置 GOMAXPROCS：1–2 核节点交给 Go 运行时按 CPU 配额自行决定。
Environment=GOGC=50
Environment=GOMEMLIMIT=8MiB
Environment=GODEBUG=disablethp=1
EnvironmentFile=-/etc/nodesteer/agent.env
ExecStart=/usr/local/bin/nodesteer-agent --config /etc/nodesteer/agent.yaml
Restart=on-failure
RestartSec=5
StateDirectory=nodesteer
StateDirectoryMode=0750
# 注意：Managed systemd 需要能够调用 systemctl（保留 CAP_SYS_ADMIN 等由部署环境决定）
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
