# NodeSteer Agent 配置示例
hub_url: "ws://hub.example.com:8443"
registration_token: "change-me"
# 可选：覆盖 Agent 注册时上报的节点名称和 IP。
node_name: ""
node_ip: ""
deployment_mode: "native" # native | docker | docker_host_integration
host_integration: false
host_root: "/host"
host_path_allowlist: ["/etc", "/opt", "/usr/local/bin", "/var/lib"]
tls_ca_file: ""
data_dir: "/var/lib/nodesteer"
agent_version: "0.1.0"
heartbeat_sec: 30
revision_check_sec: 45
max_log_bytes: 1048576

# 可选：Hub 主动拨号（入站）配置；通常由 Hub 下载的 bundle 自动写入，不要手工拼接证书内容。
# inbound:
#   listen_addr: "0.0.0.0:18444"
#   endpoint: "agent.example.com:18444"
#   cert_file: "/etc/nodesteer/inbound/agent-server.pem"
#   key_file: "/etc/nodesteer/inbound/agent-server-key.pem"
#   ca_file: "/etc/nodesteer/inbound/ca.pem"
#   hub_client_fingerprint_file: "/etc/nodesteer/inbound/hub-client-fingerprint.txt"
#   token_file: "/etc/nodesteer/inbound/inbound-token"
#   allowed_source_cidrs: ["203.0.113.10/32"]
#   max_connections: 8
#   handshake_timeout: "20s"
