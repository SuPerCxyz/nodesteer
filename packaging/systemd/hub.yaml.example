# NodeSteer Hub 配置示例
web_addr: ":8080"
gateway_addr: ":8443"
# Agent 可访问的 Gateway 公网/内网基址；留空时按 base_url 和 gateway_addr 推导。
# gateway_base_url: ""  # 反代部署必填：对外 Gateway 地址（通常与 base_url 同值）；仅直连暴露（对外端口=监听端口）时留空
# 生产环境配置证书后启用 HTTPS/WSS；开发环境可留空使用 HTTP/WS。
web_tls_cert: ""
web_tls_key: ""
gateway_tls_cert: ""
gateway_tls_key: ""
registration_token: "change-me"
data_dir: "/var/lib/nodesteer-hub"
artifact_dir: "/var/lib/nodesteer-hub/artifacts"
# 未打包的本地 Hub 开发构建的 Agent 回退路径；标准 Hub 可执行文件已内置 payload。
agent_binary_amd64_path: "/usr/local/bin/nodesteer-agent"
agent_binary_arm64_path: ""
base_url: "http://localhost:8080"
admin_username: "admin"
admin_password: "change-me"
session_ttl: 24h
revision_check_sec: 30
changelog_window: 5000
heartbeat_timeout: 90s
max_file_transfer_bytes: 10737418240

# OIDC 登录（可选）。allow_local_login 是两种登录方式的互斥选择器（默认 true）：
#   true（默认，含未显式配置）= 本地密码登录可用；OIDC 完全失效
#     —— 启动不做 discovery、不构造 OIDC 客户端，/api/oidc/login 返回 404。
#   false = SSO 唯一登录方式 —— 密码登录一律 403（与本地账户是否存在无关）；
#     此模式必须配置 issuer 且启动期 discovery 成功，否则 Hub 拒绝启动
#     （恢复：切回 allow_local_login: true 后重启）。
# oidc:
#   issuer: "https://your-idp.example.com/realms/myrealm"
#   client_id: "nodesteer"
#   redirect_url: "http://localhost:8080/api/oidc/callback"  # 默认 = base_url + /api/oidc/callback
#   scopes: ["openid", "profile", "email"]
#   username_claim: "preferred_username"   # fallback: email, sub
#   role_claim: "groups"
#   role_mappings:
#     admins: "administrator"
#     ops: "operator"
#   default_role: "viewer"
#   # 登录方式互斥选择器（未显式配置时按 true 处理）
#   allow_local_login: true
#
# 注意：仅 allow_local_login=false 时 SSO 才是登录入口。该模式下请确保 IdP 中存在
# 可映射为 administrator 的账号，否则将无法通过 Web UI 管理 Hub；本地密码登录不可用。
# 环境变量覆盖：NODESTEER_OIDC_ISSUER / NODESTEER_OIDC_CLIENT_ID /
# NODESTEER_OIDC_REDIRECT_URL / NODESTEER_OIDC_USERNAME_CLAIM /
# NODESTEER_OIDC_ROLE_CLAIM / NODESTEER_OIDC_DEFAULT_ROLE /
# NODESTEER_OIDC_ALLOW_LOCAL_LOGIN
# 注意：role_mappings 只能写在本文件，环境变量不支持。
