    },
    "delta_agent_minus_hub_sample": 0,
    "own_changes_in_window": [
      {
        "global_revision": 3615,
        "object_type": "script",
        "object_id": "23984e5a-ecf5-491b-af97-176e2f29e69d",
        "object_revision": 4,
