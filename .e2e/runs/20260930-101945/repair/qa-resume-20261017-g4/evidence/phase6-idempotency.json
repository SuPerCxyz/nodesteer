  "attempt02_pattern_reproduction": {
    "observed_pattern_under_review": "attempt02: sampled_b_hub_desired_revision=1573 vs b_db_after_sync=1575 (delta 2)",
    "primary_reproduction": "evidence/phase5-recovery-r2.json controlled_gap_explanation: hub-side sample 3610 (node row while the agent was stopped) vs agent-side read 3612 after recovery, delta 2 = the two owned changes 3611/3612",
    "this_window": "the hub row advanced to 3616 within the sampling window because the agent sends SYNC_ACK immediately after applying (ack latency here <1.2s), so this window shows the invariant and the convergence rather than the lag",
    "hub_side_sample_t1": {
      "status": "online",
      "sync_status": "synced",
      "global_revision": 3616
    },
    "agent_side_read_t2": {
