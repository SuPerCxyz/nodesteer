    "source_lines_redacted": [
      {
        "line": 1,
        "tags": [],
        "source": "import asyncio,json,os,sys"
      },
      {
        "line": 2,
        "tags": [],
        "source": "from pathlib import Path"
      },
      {
        "line": 3,
        "tags": [],
        "source": "sys.path.insert(0,sys.argv[1])"
      },
      {
        "line": 4,
        "tags": [],
        "source": "from ws_proxy import Proxy"
      },
      {
        "line": 5,
        "tags": [],
        "source": "node_ip=sys.argv[2]; upstream_host=sys.argv[3]; upstream_port=int(sys.argv[4]); controls=Path(sys.argv[5]); events=Path(sys.argv[6]); ready=Path(sys.argv[7])"
      },
      {
        "line": 6,
        "tags": [],
        "source": "proxy=Proxy(controls,events,upstream_host,upstream_port)"
      },
      {
        "line": 7,
        "tags": [],
        "source": "active=False"
      },
      {
        "line": 8,
        "tags": [],
        "source": "async def handler(reader,writer):"
      },
      {
        "line": 9,
        "tags": [],
        "source": " global active"
      },
      {
        "line": 10,
        "tags": [],
        "source": " peer=writer.get_extra_info(\"peername\")"
      },
      {
        "line": 11,
        "tags": [],
        "source": " if not peer or not peer[0].startswith(\"127.\") or active:"
      },
      {
        "line": 12,
        "tags": [],
        "source": "  writer.close()"
      },
      {
        "line": 13,
        "tags": [
          "wait"
        ],
        "source": "  try: await writer.wait_closed()"
      },
      {
        "line": 14,
        "tags": [],
        "source": "  except Exception: pass"
      },
      {
        "line": 15,
        "tags": [],
        "source": "  return"
      },
      {
        "line": 16,
        "tags": [],
        "source": " active=True"
      },
      {
        "line": 17,
        "tags": [
          "wait"
        ],
        "source": " try: await proxy.connection(reader,writer)"
      },
      {
        "line": 18,
        "tags": [],
        "source": " finally: active=False"
      },
      {
        "line": 19,
        "tags": [],
        "source": "async def run():"
      },
      {
        "line": 20,
        "tags": [
          "wait"
        ],
        "source": " server=await asyncio.start_server(handler,node_ip,0)"
      },
      {
        "line": 21,
        "tags": [],
        "source": " port=server.sockets[0].getsockname()[1]"
      },
      {
        "line": 22,
        "tags": [],
        "source": " temp=ready.with_suffix(\".tmp\")"
      },
      {
        "line": 23,
        "tags": [],
        "source": " temp.write_text(json.dumps({\"port\":port},separators=(\",\",\":\")))"
      },
      {
        "line": 24,
        "tags": [],
        "source": " os.chmod(temp,0o600)"
      },
      {
        "line": 25,
        "tags": [],
        "source": " temp.replace(ready)"
      },
      {
        "line": 26,
        "tags": [
          "wait"
        ],
        "source": " async with server: await server.serve_forever()"
      },
      {
        "line": 27,
        "tags": [],
        "source": "asyncio.run(run())"
      }
    ],
