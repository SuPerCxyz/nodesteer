# NodeSteer Hub 配置

# Hub Web/API 端口（单入口模式：Gateway 与 Web 同用此端口）
HUB_WEB_PORT=8080
# 单入口模式：8080 同时承载 Web、纳管下载、Agent WebSocket 与文件传输，对外只需暴露这一个端口。
# 想回双端口：在 docker-compose.yml 放开 8443 端口注释、把 NODESTEER_GATEWAY_ADDR 改回 :8443，再取消下行注释。
# HUB_GATEWAY_PORT=8443
# Agent 首次注册 Token
REGISTRATION_TOKEN=changeme
# Agent 访问 Hub 的 Base URL（用于 Artifact 下载）
HUB_BASE_URL=http://localhost:8080
# 未打包的本地 Hub 开发构建的 Agent 回退路径（标准 Hub 镜像无需设置）
# AGENT_BINARY_AMD64_PATH=/usr/local/bin/nodesteer-agent
# AGENT_BINARY_ARM64_PATH=
# 默认管理员
ADMIN_USERNAME=admin
# 生产必须设置；仅隔离测试可配合 NODESTEER_ALLOW_EMPTY_PASSWORD=true 使用空密码。
ADMIN_PASSWORD=
# 仅隔离测试：允许管理员空密码登录；默认 false，生产禁用。
# NODESTEER_ALLOW_EMPTY_PASSWORD=true

# --- OIDC SSO（可选）---
# 登录方式互斥选择器 OIDC_ALLOW_LOCAL_LOGIN（默认 true）：
#   true  = 本地密码登录可用；即使配置 OIDC_ISSUER，SSO 也完全失效
#           （不 discovery、/api/oidc/login 返回 404）。
#   false = SSO 唯一登录方式：必须配置 OIDC_ISSUER，否则 Hub 拒绝启动；
#           密码登录一律 403（与本地账户是否存在无关）；discovery 失败也拒启。
# 角色映射（role_mappings）仅支持 hub.yaml 配置文件；纯 env 部署时所有 SSO
# 用户将按 OIDC_DEFAULT_ROLE 落角色，故 default_role 决定了"谁能否管理 Hub"。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URL=            # 默认 http://<HUB_BASE_URL>/api/oidc/callback
OIDC_USERNAME_CLAIM=          # 默认 preferred_username
OIDC_ROLE_CLAIM=              # 默认 groups
OIDC_DEFAULT_ROLE=            # 默认 viewer；无 role_mappings 时勿设 administrator
# false 模式故障恢复 = 切回 true 并重启（本地密码登录立即恢复）
OIDC_ALLOW_LOCAL_LOGIN=true

# --- 入站连接（可选，默认关闭）---
# Agent 无法出站访问 Hub 时，由 Hub 主动拨号 Agent 的 TCP 18444。
# 启用前确认 Hub 可出站访问 endpoint，且 Agent 仅对 Hub 出口地址放行 18444。
# NODESTEER_INBOUND_ENABLED=true
# 未显式提供时在 ${NODESTEER_DATA_DIR}/inbound 自动生成；CA 私钥必须备份且保持 0600。
# NODESTEER_INBOUND_CA_FILE=/var/lib/nodesteer-hub/inbound/ca.pem
# NODESTEER_INBOUND_CA_KEY_FILE=/var/lib/nodesteer-hub/inbound/ca-key.pem
# NODESTEER_INBOUND_CLIENT_CERT_FILE=/var/lib/nodesteer-hub/inbound/client.pem
# NODESTEER_INBOUND_CLIENT_KEY_FILE=/var/lib/nodesteer-hub/inbound/client-key.pem
# NODESTEER_INBOUND_ALLOWED_PORTS=18444
# 仅隔离测试可放行 loopback；生产保持 false。
# NODESTEER_INBOUND_ALLOW_LOOPBACK=false
# NODESTEER_INBOUND_DENIED_CIDRS=
# 拨号并发/超时/退避。
# NODESTEER_INBOUND_DIAL_CONCURRENCY=16
# NODESTEER_INBOUND_DIAL_TIMEOUT=20s
# NODESTEER_INBOUND_BACKOFF_INITIAL=2s
# NODESTEER_INBOUND_BACKOFF_MAX=1m

# --- 监控（可选）---
# 允许探测的 CIDR，逗号分隔；留空表示不允许向任何地址发起监控请求。
MONITOR_ALLOWED_CIDRS=
# 采集并发数（1–128）；留空使用默认值 8。
MONITOR_WORKERS=
# Agent 侧探测凭据目的地映射（JSON 对象：变量名 → 允许的 HTTPS origin 数组）；
# 映射的是变量名，不是 secret 本身。
MONITOR_SECRET_DESTINATIONS=
# 原生节点指标由同一个 Agent 采集；默认开启，默认 30s，运行时限制 5s–300s。
# Compose 映射为容器内 NODESTEER_METRICS_ENABLED / NODESTEER_METRICS_INTERVAL。
# 直接运行 Agent 时使用 NODESTEER_METRICS_ENABLED / NODESTEER_METRICS_INTERVAL。
MONITOR_METRICS_ENABLED=true
MONITOR_METRICS_INTERVAL=30s
# Hub 原生时序保留期（目标默认值）：raw 7d、1m 90d、5m 1y、1h 2y。
# NODE_METRICS ingest、周期聚合/清理和查询 API 已接入；保留期为代码常量，
# 暂不提供保留期环境变量。
# Nocturne 已移除；已有历史不迁移、不回填、不在新界面展示。

# --- 告警通知渠道（仅示例变量名）---
# 渠道配置的 url_env/token_env/password_env/to_env 引用以下变量名；
# 真实值只注入 Hub 进程环境，不写入 DB、日志、API 或版本库。
# ALERT_WEBHOOK_URL=
# ALERT_SLACK_WEBHOOK_URL=
# ALERT_DINGTALK_WEBHOOK_URL=
# ALERT_WECOM_WEBHOOK_URL=
# ALERT_TELEGRAM_TOKEN=
# ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_TO=

# Agent 模式: native | docker | docker_host_integration
# DEPLOYMENT_MODE=native
