# NodeSteer Hub 配置

# Hub Web/API 端口（单入口模式：Gateway 与 Web 同用此端口）
HUB_WEB_PORT=8080
# 单入口模式：8080 同时承载 Web、纳管下载、Agent WebSocket 与文件传输，对外只需暴露这一个端口。
# 想回双端口：在 docker-compose.yml 放开 8443 端口注释、把 NODESTEER_GATEWAY_ADDR 改回 :8443，再取消下行注释。
# HUB_GATEWAY_PORT=8443
# Agent 首次注册 Token
REGISTRATION_TOKEN=changeme
# Agent 访问 Hub 的 Base URL（用于 Artifact 下载）
HUB_BASE_URL=http://localhost:8080
# 未打包的本地 Hub 开发构建的 Agent 回退路径（标准 Hub 镜像无需设置）
# AGENT_BINARY_AMD64_PATH=/usr/local/bin/nodesteer-agent
# AGENT_BINARY_ARM64_PATH=
# 默认管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- OIDC SSO（可选）---
# 登录方式互斥选择器 OIDC_ALLOW_LOCAL_LOGIN（默认 true）：
#   true  = 本地密码登录可用；即使配置 OIDC_ISSUER，SSO 也完全失效
#           （不 discovery、/api/oidc/login 返回 404）。
#   false = SSO 唯一登录方式：必须配置 OIDC_ISSUER，否则 Hub 拒绝启动；
#           密码登录一律 403（与本地账户是否存在无关）；discovery 失败也拒启。
# 角色映射（role_mappings）仅支持 hub.yaml 配置文件；纯 env 部署时所有 SSO
# 用户将按 OIDC_DEFAULT_ROLE 落角色，故 default_role 决定了"谁能否管理 Hub"。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URL=            # 默认 http://<HUB_BASE_URL>/api/oidc/callback
OIDC_USERNAME_CLAIM=          # 默认 preferred_username
OIDC_ROLE_CLAIM=              # 默认 groups
OIDC_DEFAULT_ROLE=            # 默认 viewer；无 role_mappings 时勿设 administrator
# false 模式故障恢复 = 切回 true 并重启（本地密码登录立即恢复）
OIDC_ALLOW_LOCAL_LOGIN=true

# Agent 模式: native | docker | docker_host_integration
# DEPLOYMENT_MODE=native
